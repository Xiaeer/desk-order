.shop-page {
	padding: 24rpx;
}

.toolbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 22rpx 24rpx;
	margin-bottom: 20rpx;
}

.location-debug {
	padding: 22rpx 24rpx;
	margin-bottom: 20rpx;
	background: #fffaf5;
	border: 1px solid #ffe2d5;
}

.location-debug-title {
	font-size: 26rpx;
	font-weight: 600;
	color: #111827;
	margin-bottom: 12rpx;
}

.location-debug-row {
	display: flex;
	justify-content: space-between;
	gap: 20rpx;
	padding: 8rpx 0;
	font-size: 24rpx;
}

.location-debug-label {
	color: #8b8f9c;
}

.location-debug-value {
	color: #111827;
	font-family: 'SFMono-Regular', Consolas, monospace;
	word-break: break-all;
	text-align: right;
}

.toolbar-title {
	font-size: 32rpx;
	font-weight: 600;
}

.shop-card {
	display: flex;
	margin-bottom: 20rpx;
	padding: 22rpx;
}

.shop-logo {
	width: 112rpx;
	height: 112rpx;
	border-radius: 20rpx;
	background: #f5f5f5;
	flex-shrink: 0;
}

.shop-logo-placeholder {
	display: flex;
	align-items: center;
	justify-content: center;
	color: #ff6a3d;
	font-size: 36rpx;
	font-weight: 700;
}

.shop-content {
	flex: 1;
	margin-left: 20rpx;
}

.shop-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.shop-name {
	font-size: 30rpx;
	font-weight: 600;
	color: #111827;
}

.shop-distance {
	color: #ff6a3d;
	font-size: 24rpx;
}

.shop-desc,
.shop-address {
	margin-top: 8rpx;
	color: #8b8f9c;
	font-size: 24rpx;
	line-height: 1.6;
}

.empty {
	padding: 50rpx 24rpx;
	text-align: center;
	color: #8b8f9c;
}
