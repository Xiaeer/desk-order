.status-banner {
  padding: 40rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  background: #cce5ff;
}

.status-bg-1 { background: #fff3cd; }
.status-bg-2 { background: #d4edda; }
.status-bg-3 { background: #d1ecf1; }
.status-bg-4 { background: #f8d7da; }

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.order-no-text {
  font-size: 24rpx;
  color: #666;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-of-type {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
}

.item-option-summary {
  font-size: 22rpx;
  line-height: 1.6;
  color: #98a2b3;
}

.item-price {
  font-size: 28rpx;
  color: #333;
}

.total-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #eee;
  font-size: 30rpx;
  font-weight: bold;
}

.total-amount {
  color: #ee0a24;
  font-size: 36rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-val {
  font-size: 26rpx;
  color: #333;
}

.action-bar {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
