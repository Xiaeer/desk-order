.order-list-page {
  padding-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 10rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #07c160;
  font-weight: bold;
  border-bottom-color: #07c160;
}

.order-card {
  margin: 20rpx 30rpx;
  padding: 24rpx 30rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.order-items-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.item-preview-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-table {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #ff6a3d;
  font-weight: 600;
}

.item-name {
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-option-summary {
  max-width: 480rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #98a2b3;
}

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ee0a24;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
